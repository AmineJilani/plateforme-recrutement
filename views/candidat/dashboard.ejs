<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Candidat</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .header {
            background-color: #7d3cff;
            color: white;
            padding: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .header img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            margin-right: 15px;
        }
        .btn-logout {
            background-color: transparent;
            color: white;
            border: 1px solid white;
        }
        .btn-logout:hover {
            background-color: rgba(255, 255, 255, 0.15);
            color: white;
        }
        .filter-section {
            background: #e9ecef;
            padding: 15px;
            border-radius: 8px;
        }
        .job-card {
            background: white;
            border-radius: 8px;
            padding: 15px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .btn-purple {
            background-color: #7d3cff;
            color: white;
            border: none;
        }
        .job-logo {
            width: 40px;
            height: 40px;
            margin-right: 10px;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="d-flex align-items-center">
            <img src="/images/icone.png" alt="Profil">
            <div>
                <h4><%= utilisateur.nom %> <%= utilisateur.prenom %></h4>
                <p class="m-0">Candidat</p>
            </div>
        </div>
        <a href="/logout" class="btn btn-logout">Déconnexion</a>
    </div>

    <div class="container mt-3">
        <div class="row">
            <!-- Colonne des filtres -->
            <div class="col-md-3">
                <div class="filter-section">
                    <h5>Filtres</h5>
                    <div class="mb-3">
                        <label for="localisation" class="form-label">Localisation</label>
                        <input type="text" class="form-control" id="localisation" placeholder="Ex : Paris, Lyon...">
                    </div>

                    <div class="mb-3">
                        <label for="rythme" class="form-label">Rythme</label>
                        <input type="text" class="form-control" id="rythme" placeholder="Ex : temps plein, alternance...">
                    </div>

                    <div class="mb-3">
                        <label for="typeMetier" class="form-label">Type de métier</label>
                        <input type="text" class="form-control" id="typeMetier" placeholder="Ex : développement, marketing...">
                    </div>

                    <button id="btnAppliquerFiltres" type="button" class="btn btn-purple w-100">Appliquer les filtres</button>
                    <button id="btnReinitialiserFiltres" type="button" class="btn btn-outline-secondary w-100 mt-2">Réinitialiser</button>
                </div>
            </div>
            <!-- Colonne des offres -->
            <div class="col-md-9">
                <input type="text" class="form-control mb-3" id="rechercheOffres" placeholder="Rechercher des offres d'emploi">

                <p id="aucunResultat" class="d-none">Aucune offre ne correspond à ces critères.</p>

                <% if (offres && offres.length > 0) { %>
                    <% offres.forEach(o => { %>
                        <div class="job-card"
                             data-intitule="<%= (o.fiche_intitule || '').toLowerCase() %>"
                             data-indication="<%= (o.indication || '').toLowerCase() %>"
                             data-lieu="<%= (o.lieu || '').toLowerCase() %>"
                             data-rythme="<%= (o.rythme || '').toLowerCase() %>"
                             data-type-metier="<%= (o.type_metier || '').toLowerCase() %>">
                            <div class="d-flex align-items-center">
                                <div>
                                    <h6><%= o.fiche_intitule %></h6> <!-- Affichage de l'intitulé de la fiche -->
                                    <p class="mb-1"><%= o.indication %></p> <!-- Affichage de l'indication -->
                                    <small class="text-muted">Validité : <%= new Date(o.date_validite).toLocaleDateString('fr-FR') %></small> <!-- Affichage de la date de validité -->
                                </div>
                            </div>
                            <div>
                                <button onclick="location.href='/candidat/fiche/<%= o.Id_poste %>'" class="btn btn-outline-secondary">Détails</button>
                                <button onclick="location.href='/candidat/candidater/<%= o.Id_poste %>'" class="btn btn-purple">Candidater</button>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p>Aucune offre d'emploi disponible.</p>
                <% } %>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const rechercheInput = document.getElementById('rechercheOffres');
        const localisationInput = document.getElementById('localisation');
        const rythmeInput = document.getElementById('rythme');
        const typeMetierInput = document.getElementById('typeMetier');
        const btnAppliquer = document.getElementById('btnAppliquerFiltres');
        const btnReinitialiser = document.getElementById('btnReinitialiserFiltres');
        const cartes = Array.from(document.querySelectorAll('.job-card'));
        const aucunResultat = document.getElementById('aucunResultat');

        function appliquerFiltres() {
            const recherche = rechercheInput.value.trim().toLowerCase();
            const localisation = localisationInput.value.trim().toLowerCase();
            const rythme = rythmeInput.value.trim().toLowerCase();
            const typeMetier = typeMetierInput.value.trim().toLowerCase();

            let visibles = 0;
            cartes.forEach(carte => {
                const correspondRecherche = !recherche
                    || carte.dataset.intitule.includes(recherche)
                    || carte.dataset.indication.includes(recherche);
                const correspondLocalisation = !localisation || carte.dataset.lieu.includes(localisation);
                const correspondRythme = !rythme || carte.dataset.rythme.includes(rythme);
                const correspondTypeMetier = !typeMetier || carte.dataset.typeMetier.includes(typeMetier);

                const visible = correspondRecherche && correspondLocalisation && correspondRythme && correspondTypeMetier;
                carte.classList.toggle('d-none', !visible);
                if (visible) visibles++;
            });

            aucunResultat.classList.toggle('d-none', visibles !== 0 || cartes.length === 0);
        }

        [rechercheInput, localisationInput, rythmeInput, typeMetierInput].forEach(input => {
            input.addEventListener('input', appliquerFiltres);
        });
        btnAppliquer.addEventListener('click', appliquerFiltres);
        btnReinitialiser.addEventListener('click', () => {
            rechercheInput.value = '';
            localisationInput.value = '';
            rythmeInput.value = '';
            typeMetierInput.value = '';
            appliquerFiltres();
        });
    </script>
</body>
</html>
