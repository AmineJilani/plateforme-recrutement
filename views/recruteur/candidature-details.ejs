<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact - <%= candidat.nom %> <%= candidat.prenom %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <h3>Informations de Contact du Candidat</h3>

        <p><strong>Nom:</strong> <%= candidat.nom %></p>
        <p><strong>Prénom:</strong> <%= candidat.prenom %></p>
        <p><strong>Email:</strong> <%= candidat.email %></p>
        <p><strong>Téléphone:</strong> <%= candidat.telephone %></p>

        <a href="/recruteur/gestion-candidatures/<%= offreId %>" class="btn btn-primary">Retour aux candidatures</a>
    </div>
</body>
</html>

