<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Publier une offre</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .header {
            background-color: #7d3cff;
            color: white;
            padding: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .header img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            margin-right: 15px;
        }
        .form-section {
            background: white;
            padding: 30px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            margin-top: 30px;
        }
        .btn-purple {
            background-color: #7d3cff;
            color: white;
            border: none;
        }
        .btn-logout {
            background-color: transparent;
            color: white;
            border: 1px solid white;
        }
        .btn-logout:hover {
            background-color: rgba(255, 255, 255, 0.15);
            color: white;
        }
        .error-box {
            background: #f8d7da;
            color: #842029;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 15px;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="d-flex align-items-center">
            <img src="/images/icone.png" alt="Recruteur">
            <div>
                <h4><%= utilisateur.nom %> <%= utilisateur.prenom %></h4>
                <p class="m-0">Recruteur</p>
            </div>
        </div>
        <a href="/logout" class="btn btn-logout">Déconnexion</a>
    </div>

    <div class="container mt-3">
        <a href="/recruteur/dashboard" class="btn btn-outline-secondary mb-3">← Retour au tableau de bord</a>

        <div class="form-section">
            <h3 class="mb-4">Publier une nouvelle offre</h3>

            <% if (error) { %>
                <div class="error-box"><%= error %></div>
            <% } %>

            <form action="/recruteur/nouvelle-offre" method="POST">
                <h5>Fiche de poste</h5>
                <div class="mb-3">
                    <label class="form-label">Intitulé du poste</label>
                    <input type="text" class="form-control" name="intitule" required>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Statut du poste</label>
                        <input type="text" class="form-control" name="statut_poste" placeholder="Ex : ouvert" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Type de métier</label>
                        <input type="text" class="form-control" name="type_metier">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Lieu</label>
                        <input type="text" class="form-control" name="lieu">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Rythme</label>
                        <input type="text" class="form-control" name="rythme" placeholder="Ex : temps plein">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Salaire</label>
                        <input type="text" class="form-control" name="salaire">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Description du poste</label>
                    <textarea class="form-control" name="description" rows="4" required></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Responsable hiérarchique</label>
                    <input type="text" class="form-control" name="responsable_hier" value="<%= utilisateur.nom %> <%= utilisateur.prenom %>">
                </div>

                <hr class="my-4">

                <h5>Offre d'emploi</h5>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">État de l'offre</label>
                        <input type="text" class="form-control" name="Etat" placeholder="Ex : ouverte" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Date de validité</label>
                        <input type="date" class="form-control" name="date_validite" required>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Indications complémentaires</label>
                    <textarea class="form-control" name="indication" rows="2"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Nombre de pièces demandées au candidat</label>
                    <input type="number" class="form-control" name="nbr_piece" min="0" value="2" required>
                </div>

                <button type="submit" class="btn btn-purple">Publier l'offre</button>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
