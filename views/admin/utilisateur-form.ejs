<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= utilisateur ? 'Modifier' : 'Ajouter' %> un utilisateur</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .header {
            background-color: #7d3cff;
            color: white;
            padding: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .header img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            margin-right: 15px;
        }
        .btn-purple {
            background-color: #7d3cff;
            color: white;
            border: none;
        }
        .btn-logout {
            background-color: transparent;
            color: white;
            border: 1px solid white;
        }
        .btn-logout:hover {
            background-color: rgba(255, 255, 255, 0.15);
            color: white;
        }
        .form-section {
            background: white;
            padding: 30px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            margin-top: 30px;
        }
        .error-box {
            background: #f8d7da;
            color: #842029;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 15px;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="d-flex align-items-center">
            <img src="/images/icone.png" alt="Administrateur">
            <div>
                <h4><%= utilisateurCourant.nom %> <%= utilisateurCourant.prenom %></h4>
                <p class="m-0">Administrateur</p>
            </div>
        </div>
        <a href="/logout" class="btn btn-logout">Déconnexion</a>
    </div>

    <div class="container mt-3">
        <a href="/admin/dashboard" class="btn btn-outline-secondary mb-3">← Retour au tableau de bord</a>

        <div class="form-section">
            <h3 class="mb-4"><%= utilisateur ? 'Modifier l\'utilisateur' : 'Ajouter un utilisateur' %></h3>

            <% if (error) { %>
                <div class="error-box"><%= error %></div>
            <% } %>

            <form action="<%= utilisateur ? '/admin/utilisateurs/' + utilisateur.Id + '/modifier' : '/admin/utilisateurs' %>" method="POST">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nom</label>
                        <input type="text" class="form-control" name="Nom" value="<%= utilisateur ? utilisateur.Nom : '' %>" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Prénom</label>
                        <input type="text" class="form-control" name="Prenom" value="<%= utilisateur ? utilisateur.Prenom : '' %>" required>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Téléphone</label>
                        <input type="text" class="form-control" name="Telephone" value="<%= utilisateur ? utilisateur.Telephone : '' %>" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" name="email" value="<%= utilisateur ? utilisateur.email : '' %>" required>
                    </div>
                </div>

                <% if (!utilisateur) { %>
                    <div class="mb-3">
                        <label class="form-label">Mot de passe initial</label>
                        <input type="password" class="form-control" name="password" required minlength="6">
                    </div>
                <% } else { %>
                    <p class="text-muted">Le mot de passe n'est pas modifiable depuis ce formulaire.</p>
                <% } %>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Rôle</label>
                        <select class="form-select" name="role" required>
                            <% roles.forEach(r => { %>
                                <option value="<%= r %>" <%= utilisateur && utilisateur.role === r ? 'selected' : '' %>><%= r %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Organisation (candidat : laisser vide)</label>
                        <select class="form-select" name="organisation_id">
                            <option value="">— Aucune —</option>
                            <% organisations.forEach(o => { %>
                                <option value="<%= o.Siren %>" <%= utilisateur && utilisateur.organisation_id === o.Siren ? 'selected' : '' %>><%= o.Nom %> (<%= o.Siren %>)</option>
                            <% }) %>
                        </select>
                    </div>
                </div>

                <button type="submit" class="btn btn-purple"><%= utilisateur ? 'Enregistrer' : 'Créer l\'utilisateur' %></button>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
