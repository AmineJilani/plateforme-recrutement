<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= organisation ? 'Modifier' : 'Ajouter' %> une organisation</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .header {
            background-color: #7d3cff;
            color: white;
            padding: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .header img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            margin-right: 15px;
        }
        .btn-purple {
            background-color: #7d3cff;
            color: white;
            border: none;
        }
        .btn-logout {
            background-color: transparent;
            color: white;
            border: 1px solid white;
        }
        .btn-logout:hover {
            background-color: rgba(255, 255, 255, 0.15);
            color: white;
        }
        .form-section {
            background: white;
            padding: 30px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            margin-top: 30px;
        }
        .error-box {
            background: #f8d7da;
            color: #842029;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 15px;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="d-flex align-items-center">
            <img src="/images/icone.png" alt="Administrateur">
            <div>
                <h4><%= utilisateurCourant.nom %> <%= utilisateurCourant.prenom %></h4>
                <p class="m-0">Administrateur</p>
            </div>
        </div>
        <a href="/logout" class="btn btn-logout">Déconnexion</a>
    </div>

    <div class="container mt-3">
        <a href="/admin/dashboard" class="btn btn-outline-secondary mb-3">← Retour au tableau de bord</a>

        <div class="form-section">
            <h3 class="mb-4"><%= organisation ? 'Modifier l\'organisation' : 'Ajouter une organisation' %></h3>

            <% if (error) { %>
                <div class="error-box"><%= error %></div>
            <% } %>

            <form action="<%= organisation ? '/admin/organisations/' + organisation.Siren + '/modifier' : '/admin/organisations' %>" method="POST">
                <div class="mb-3">
                    <label class="form-label">SIREN</label>
                    <input type="number" class="form-control" name="Siren" value="<%= organisation ? organisation.Siren : '' %>" <%= organisation ? 'readonly' : '' %> required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Nom</label>
                    <input type="text" class="form-control" name="Nom" value="<%= organisation ? organisation.Nom : '' %>" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Adresse</label>
                    <input type="text" class="form-control" name="adresse_admini" value="<%= organisation ? organisation.adresse_admini : '' %>">
                </div>
                <div class="mb-3">
                    <label class="form-label">Type</label>
                    <select class="form-select" name="type" required>
                        <option value="entreprise" <%= organisation && organisation.type === 'entreprise' ? 'selected' : '' %>>Entreprise</option>
                        <option value="association" <%= organisation && organisation.type === 'association' ? 'selected' : '' %>>Association</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-purple"><%= organisation ? 'Enregistrer' : 'Créer l\'organisation' %></button>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
