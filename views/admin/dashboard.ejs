<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administrateur</title>
    <!-- Lien vers Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }
        .header {
            background-color: #7d3cff;
            color: white;
            padding: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .header img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            margin-right: 15px;
        }
        .btn-logout {
            background-color: transparent;
            color: white;
            border: 1px solid white;
        }
        .btn-logout:hover {
            background-color: rgba(255, 255, 255, 0.15);
            color: white;
        }
        .filter-section {
            background: #e9ecef;
            padding: 20px;
            border-radius: 8px;
        }
        .btn-purple {
            background-color: #7d3cff;
            color: white;
            border: none;
            padding: 8px 12px;
            border-radius: 5px;
            cursor: pointer;
        }
        .offer-card {
            background: white;
            border-radius: 8px;
            padding: 15px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .offer-logo {
            width: 50px;
            height: 50px;
            border-radius: 5px;
            margin-right: 15px;
        }
        .filter-buttons button {
            margin: 5px;
            padding: 10px;
            border: none;
            border-radius: 5px;
            background-color: #6c757d;
            color: white;
            cursor: pointer;
        }
        .filter-buttons button:hover {
            background-color: #5a6268;
        }
    </style>
</head>
<body>
    <!-- Header avec nom et prénom -->
    <div class="header">
        <div class="d-flex align-items-center">
            <img src="/images/icone.png" alt="Administrateur">
            <div>
                <h4><%= utilisateur.nom %> <%= utilisateur.prenom %></h4>
                <p class="m-0"><%= utilisateur.role %></p>
            </div>
        </div>
        <a href="/logout" class="btn btn-logout">Déconnexion</a>
    </div>

    <div class="container mt-4">
        <div class="row">
            <!-- Menu à gauche pour sélectionner les sections -->
            <div class="col-md-3">
                <div class="filter-section">
                    <h5>Gestionnaire</h5>
                    <div class="filter-buttons">
                        <button type="button" class="btn btn-purple" id="btnUtilisateurs">Utilisateurs</button>
                        <button type="button" class="btn btn-purple" id="btnOrganisations">Organisations</button>
                    </div>
                </div>
            </div>

            <!-- Section principale à droite -->
            <div class="col-md-9">
                <!-- Recherche -->
                <input type="text" class="form-control mb-3" id="rechercheAdmin" placeholder="Rechercher">

                <!-- Section des utilisateurs -->
                <div id="utilisateursSection" class="mt-4 d-none">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5>Liste des utilisateurs</h5>
                        <a href="/admin/utilisateurs/nouveau" class="btn btn-purple">+ Ajouter un utilisateur</a>
                    </div>
                    <div class="offer-card">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th scope="col">Nom</th>
                                    <th scope="col">Prénom</th>
                                    <th scope="col">Email</th>
                                    <th scope="col">Role</th>
                                    <th scope="col">Organisation</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% utilisateurs.forEach(u => {
                                    const orga = organisations.find(o => o.Siren === u.organisation_id);
                                    const orgaNom = orga ? orga.Nom : '';
                                    const texteRecherche = [u.Nom, u.Prenom, u.email, u.role, orgaNom].join(' ').toLowerCase();
                                %>
                                    <tr data-recherche="<%= texteRecherche %>">
                                        <td><%= u.Nom %></td>
                                        <td><%= u.Prenom %></td>
                                        <td><%= u.email %></td>
                                        <td><%= u.role %></td>
                                        <td><%= orgaNom || '—' %></td>
                                        <td>
                                            <a href="/admin/utilisateurs/<%= u.Id %>/modifier" class="btn btn-sm btn-outline-secondary">Modifier</a>
                                            <form action="/admin/utilisateurs/<%= u.Id %>/supprimer" method="POST" class="d-inline" onsubmit="return confirm('Supprimer cet utilisateur ?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                        <p id="aucunResultatUtilisateurs" class="d-none text-muted mb-0">Aucun utilisateur ne correspond à cette recherche.</p>
                    </div>
                </div>

                <!-- Section des organisations -->
                <div id="organisationsSection" class="mt-4 d-none">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5>Liste des organisations</h5>
                        <a href="/admin/organisations/nouvelle" class="btn btn-purple">+ Ajouter une organisation</a>
                    </div>
                    <div class="offer-card">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th scope="col">Nom de l'organisation</th>
                                    <th scope="col">Type</th>
                                    <th scope="col">Adresse</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% organisations.forEach(o => {
                                    const texteRecherche = [o.Nom, o.type, o.adresse_admini].join(' ').toLowerCase();
                                %>
                                    <tr data-recherche="<%= texteRecherche %>">
                                        <td><%= o.Nom %></td>
                                        <td><%= o.type %></td>
                                        <td><%= o.adresse_admini %></td>
                                        <td>
                                            <a href="/admin/organisations/<%= o.Siren %>/modifier" class="btn btn-sm btn-outline-secondary">Modifier</a>
                                            <form action="/admin/organisations/<%= o.Siren %>/supprimer" method="POST" class="d-inline" onsubmit="return confirm('Supprimer cette organisation ?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                        <p id="aucunResultatOrganisations" class="d-none text-muted mb-0">Aucune organisation ne correspond à cette recherche.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Script pour gérer l'affichage des sections en fonction du bouton cliqué, et la recherche -->
    <script>
        const rechercheInput = document.getElementById('rechercheAdmin');
        const sectionUtilisateurs = document.getElementById('utilisateursSection');
        const sectionOrganisations = document.getElementById('organisationsSection');
        const aucunResultatUtilisateurs = document.getElementById('aucunResultatUtilisateurs');
        const aucunResultatOrganisations = document.getElementById('aucunResultatOrganisations');

        function sectionActive() {
            return sectionUtilisateurs.classList.contains('d-none') ? sectionOrganisations : sectionUtilisateurs;
        }

        function appliquerRecherche() {
            const recherche = rechercheInput.value.trim().toLowerCase();
            const section = sectionActive();
            const lignes = Array.from(section.querySelectorAll('tbody tr'));
            const aucunResultat = section === sectionUtilisateurs ? aucunResultatUtilisateurs : aucunResultatOrganisations;

            let visibles = 0;
            lignes.forEach(ligne => {
                const visible = !recherche || ligne.dataset.recherche.includes(recherche);
                ligne.style.display = visible ? '' : 'none';
                if (visible) visibles++;
            });

            aucunResultat.classList.toggle('d-none', visibles !== 0 || lignes.length === 0);
        }

        rechercheInput.addEventListener('input', appliquerRecherche);

        document.getElementById('btnUtilisateurs').addEventListener('click', function() {
            sectionUtilisateurs.classList.remove('d-none');
            sectionOrganisations.classList.add('d-none');
            rechercheInput.value = '';
            appliquerRecherche();
        });

        document.getElementById('btnOrganisations').addEventListener('click', function() {
            sectionUtilisateurs.classList.add('d-none');
            sectionOrganisations.classList.remove('d-none');
            rechercheInput.value = '';
            appliquerRecherche();
        });
    </script>
</body>
</html>
