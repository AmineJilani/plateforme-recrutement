<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Créer un compte</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    body {
      background: url('background.jpg') no-repeat center center/cover;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      margin: 0;
      padding: 40px 0;
    }
    .login-box {
      background: #8a3ffc;
      padding: 40px;
      border-radius: 15px;
      box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.3);
      text-align: center;
    }
    .avatar {
      width: 60px;
      height: 60px;
      display: block;
      margin: 0 auto 20px;
    }
    .form-control {
      border-radius: 20px;
    }
    .btn-custom {
      background: #b49bff;
      color: white;
      border-radius: 20px;
      transition: background 0.3s ease-in-out;
    }
    .btn-custom:hover {
      background: #9b82ff;
    }
    .forgot-link {
      color: white;
      text-decoration: none;
      display: block;
      margin-top: 10px;
    }
    .error-box {
      background: rgba(255, 0, 0, 0.1);
      color: white;
      padding: 10px;
      border-radius: 10px;
      margin-bottom: 15px;
    }
  </style>
</head>
<body>
  <div class="container text-center">
    <h1 class="bg-primary text-white p-3">Find a Job</h1>
    <div class="row justify-content-center">
      <div class="col-md-4">
        <div class="login-box">

          <img src="/images/icone.png" alt="logo" class="avatar img-fluid" />

          <!-- Affichage des messages d'erreur -->
          <% if (error) { %>
            <div class="alert alert-danger" role="alert">
              <%= error %>
            </div>
          <% } %>

          <!-- Formulaire d'inscription -->
          <form action="/register" method="POST">
            <input type="text" class="form-control my-2" name="nom" required placeholder="Nom" />
            <input type="text" class="form-control my-2" name="prenom" required placeholder="Prénom" />
            <input type="tel" class="form-control my-2" name="telephone" required placeholder="Téléphone" />
            <input type="email" class="form-control my-2" name="email" required placeholder="Email" />
            <input type="password" class="form-control my-2" name="password" required placeholder="Mot de passe" />
            <input type="password" class="form-control my-2" name="confirmPassword" required placeholder="Confirmer le mot de passe" />

            <button type="submit" class="btn btn-custom w-100 mt-3">Créer mon compte</button>
          </form>

          <a href="/" class="forgot-link">Déjà un compte ? Se connecter</a>

        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
