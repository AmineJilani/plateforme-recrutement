<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Candidature - <%= offre.indication %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .header {
            background-color: #7d3cff;
            color: white;
            padding: 15px;
            display: flex;
            align-items: center;
        }
        .header img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            margin-right: 15px;
        }
        .form-section {
            background: white;
            padding: 30px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            margin-top: 30px;
        }
        .btn-purple {
            background-color: #7d3cff;
            color: white;
            border: none;
        }
    </style>
</head>
<body>
    <div class="header">
        <img src="/images/icone.png" alt="Profil">
        <div>
            <h4><%= utilisateur.nom %> <%= utilisateur.prenom %></h4>
            <p class="m-0">Candidat</p>
        </div>
    </div>

    <div class="container mt-5">
        <div class="form-section">
            <h3>Candidature à l'offre : <%= offre.indication %></h3>

            <form action="/candidat/soumettre-candidature" method="POST" enctype="multipart/form-data">

                <div class="mb-3">
                    <label for="nom" class="form-label">Nom</label>
                    <input type="text" class="form-control" id="nom" name="nom" value="<%= utilisateur.nom %>" disabled>
                </div>

                <div class="mb-3">
                    <label for="prenom" class="form-label">Prénom</label>
                    <input type="text" class="form-control" id="prenom" name="prenom" value="<%= utilisateur.prenom %>" disabled>
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" class="form-control" id="email" name="email" value="<%= utilisateur.email %>" disabled>
                </div>

                <div class="mb-3">
                    <label for="telephone" class="form-label">Telephone</label>
                    <input type="tel" class="form-control" id="telephone" name="telephone" value="<%= utilisateur.Telephone %>" disabled>
                </div>

                <div class="mb-3">
                    <label for="cv" class="form-label">CV (PDF ou DOC)</label>
                    <input type="file" class="form-control" id="cv" name="cv" accept=".pdf,.doc,.docx">
                </div>

                <div class="mb-3">
                    <label for="lettre" class="form-label">Lettre de motivation (PDF ou DOC)</label>
                    <input type="file" class="form-control" id="lettre" name="lettre" accept=".pdf,.doc,.docx">
                </div>

                <button type="submit" class="btn btn-purple">Envoyer ma candidature</button>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
