<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Candidat</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .header {
            background-color: #7d3cff;
            color: white;
            padding: 15px;
            display: flex;
            align-items: center;
        }
        .header img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            margin-right: 15px;
        }
        .filter-section {
            background: #e9ecef;
            padding: 15px;
            border-radius: 8px;
        }
        .job-card {
            background: white;
            border-radius: 8px;
            padding: 15px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .btn-purple {
            background-color: #7d3cff;
            color: white;
            border: none;
        }
        .job-logo {
            width: 40px;
            height: 40px;
            margin-right: 10px;
        }
    </style>
</head>
<body>
    <div class="header">
        <img src="/images/icone.png" alt="Profil">
        <div>
            <h4><%= utilisateur.nom %> <%= utilisateur.prenom %></h4>
            <p class="m-0">Candidat</p>
        </div>
    </div>

    <div class="container mt-3">
        <div class="row">
            <!-- Colonne des filtres -->
            <div class="col-md-3">
                <div class="filter-section">
                    <h5>Filtres</h5>
                    <div class="mb-3">
                        <label for="localisation" class="form-label">Localisation</label>
                        <input type="text" class="form-control" id="localisation" placeholder="Ex : Paris, Lyon...">
                    </div>

                    <div class="mb-3">
                        <label for="contrat" class="form-label">Type de contrat</label>
                        <select class="form-select" id="contrat">
                            <option>CDI</option>
                            <option>CDD</option>
                            <option>Stage</option>
                            <option>Alternance</option>
                            <option>Freelance</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="secteur" class="form-label">Secteur</label>
                        <select class="form-select" id="secteur">
                            <option>Informatique</option>
                            <option>Industrie</option>
                            <option>Marketing</option>
                            <option>Finance</option>
                            <option>Logistique</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="experience" class="form-label">Expérience</label>
                        <select class="form-select" id="experience">
                            <option>Débutant</option>
                            <option>1 à 3 ans</option>
                            <option>3 à 5 ans</option>
                            <option>5 ans et plus</option>
                        </select>
                    </div>

                    <button class="btn btn-purple w-100">Appliquer les filtres</button>
                </div>
            </div>
            <!-- Colonne des offres -->
            <div class="col-md-9">
                <input type="text" class="form-control mb-3" placeholder="Rechercher des offres d'emploi">

                <% if (offres && offres.length > 0) { %>
                    <% offres.forEach(o => { %>
                        <div class="job-card">
                            <div class="d-flex align-items-center">
                                <div>
                                    <h6><%= o.fiche_intitule %></h6> <!-- Affichage de l'intitulé de la fiche -->
                                    <p class="mb-1"><%= o.indication %></p> <!-- Affichage de l'indication -->
                                    <small class="text-muted">Validité : <%= new Date(o.date_validite).toLocaleDateString('fr-FR') %></small> <!-- Affichage de la date de validité -->
                                </div>
                            </div>
                            <div>
                                <button onclick="location.href='/candidat/fiche/<%= o.Id_poste %>'" class="btn btn-outline-secondary">Détails</button>
                                <button onclick="location.href='/candidat/candidater/<%= o.Id_poste %>'" class="btn btn-purple">Candidater</button>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p>Aucune offre d'emploi disponible.</p>
                <% } %>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
