<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Candidatures</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .header {
            background-color: #7d3cff;
            color: white;
            padding: 15px;
            text-align: left;
            display: flex;
            align-items: center;
        }

        .header img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            margin-right: 10px;
        }

        .status-actif {
            color: green;
            font-weight: bold;
        }

        .status-non-retenu {
            color: red;
            font-weight: bold;
        }

        .status-en-attente {
            color: orange;
            font-weight: bold;
        }

        .table th,
        .table td {
            text-align: center;
        }

        .table tbody tr:hover {
            background-color: #f1f1f1;
        }

        .btn-back {
            background-color: #7d3cff;
            color: white;
            border: none;
        }

        .btn-back:hover {
            background-color: #6a2ecc;
        }

        .btn-contact,
        .btn-download {
            background-color: #7d3cff;
            color: white;
            border: none;
        }

        .btn-contact:hover,
        .btn-download:hover {
            background-color: #6a2ecc;
        }

        .container {
            margin-top: 20px;
        }

        .header h4 {
            margin-bottom: 0;
        }

        .header p {
            font-size: 14px;
        }
    </style>
</head>

<body>
    <!-- Header avec le nom et prénom du recruteur -->
    <div class="header d-flex align-items-center">
        <div class="d-flex align-items-center">
            <img src="/images/icone.png" alt="Recruteur">
            <div>
                <!-- Le nom et prénom du recruteur sont insérés dynamiquement -->
                <h4><%= utilisateur.nom %> <%= utilisateur.prenom %></h4>
                <p class="m-0">Recruteur</p>
            </div>
        </div>
        <div class="mx-auto text-center">
            <h4>Gestion des Candidatures</h4>
        </div>
    </div>

    <div class="container">
        <h3 class="mt-4">Candidatures pour l'offre #<%= offreId %></h3>
        <a href="/recruteur/dashboard" class="btn btn-back mb-3">← Retour au tableau de bord</a>

        <% if (candidatures.length > 0) { %>
            <table class="table table-bordered table-striped">
                <thead class="thead-dark">
                    <tr>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Email</th>
                        <th>Date de candidature</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% candidatures.forEach(c => { %>
                        <tr>
                            <td><%= c.Nom %></td>
                            <td><%= c.Prenom %></td>
                            <td><%= c.email %></td>
                            <td><%= new Date(c.date_candidature).toLocaleDateString('fr-FR') %></td>
                            <td>
                                <% if (c.status === 'Retenue') { %>
                                    <span class="status-actif"><%= c.status %></span>
                                <% } else if (c.status === 'Non retenue') { %>
                                    <span class="status-non-retenu"><%= c.status %></span>
                                <% } else { %>
                                    <span class="status-en-attente"><%= c.status %></span>
                                <% } %>
                            </td>
                            <td>
                                <!-- Boutons pour contacter et télécharger le dossier -->
                                <a href="/recruteur/candidature/contact/<%= c.user_id %>" class="btn btn-primary">Contacter</a>

                                <button class="btn btn-download">Télécharger Dossier</button>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } else { %>
            <p>Aucune candidature pour cette offre.</p>
        <% } %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>

