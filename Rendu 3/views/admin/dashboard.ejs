<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administrateur</title>
    <!-- Lien vers Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }
        .header {
            background-color: #7d3cff;
            color: white;
            padding: 15px;
            display: flex;
            align-items: center;
        }
        .header img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            margin-right: 15px;
        }
        .filter-section {
            background: #e9ecef;
            padding: 20px;
            border-radius: 8px;
        }
        .btn-purple {
            background-color: #7d3cff;
            color: white;
            border: none;
            padding: 8px 12px;
            border-radius: 5px;
            cursor: pointer;
        }
        .offer-card {
            background: white;
            border-radius: 8px;
            padding: 15px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .offer-logo {
            width: 50px;
            height: 50px;
            border-radius: 5px;
            margin-right: 15px;
        }
        .filter-buttons button {
            margin: 5px;
            padding: 10px;
            border: none;
            border-radius: 5px;
            background-color: #6c757d;
            color: white;
            cursor: pointer;
        }
        .filter-buttons button:hover {
            background-color: #5a6268;
        }
    </style>
</head>
<body>
    <!-- Header avec nom et prénom -->
    <div class="header">
        <img src="/images/icone.png" alt="Administrateur">
        <div>
            <h4><%= utilisateur.nom %> <%= utilisateur.prenom %></h4>
            <p class="m-0"><%= utilisateur.role %></p>
        </div>
    </div>

    <div class="container mt-4">
        <div class="row">
            <!-- Menu à gauche pour sélectionner les sections -->
            <div class="col-md-3">
                <div class="filter-section">
                    <h5>Gestionnaire</h5>
                    <div class="filter-buttons">
                        <button type="button" class="btn btn-purple" id="btnUtilisateurs">Utilisateurs</button>
                        <button type="button" class="btn btn-purple" id="btnOrganisations">Organisations</button>
                    </div>
                </div>
            </div>

            <!-- Section principale à droite -->
            <div class="col-md-9">
                <!-- Recherche -->
                <input type="text" class="form-control mb-3" placeholder="Rechercher">

                <!-- Section des utilisateurs -->
                <div id="utilisateursSection" class="mt-4 d-none">
                    <h5>Liste des utilisateurs</h5>
                    <div class="offer-card">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th scope="col">Nom</th>
                                    <th scope="col">Prénom</th>
                                    <th scope="col">Email</th>
                                    <th scope="col">Role</th>
                                    <th scope="col">Organisation</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% utilisateurs.forEach(u => { %>
                                    <tr>
                                        <td><%= u.Nom %></td>
                                        <td><%= u.Prenom %></td>
                                        <td><%= u.email %></td>
                                        <td><%= u.role %></td>
                                        <td><%= u.organisation_id %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Section des organisations -->
                <div id="organisationsSection" class="mt-4 d-none">
                    <h5>Liste des organisations</h5>
                    <div class="offer-card">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th scope="col">Nom de l'organisation</th>
                                    <th scope="col">Type</th>
                                    <th scope="col">Adresse</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% organisations.forEach(o => { %>
                                    <tr>
                                        <td><%= o.Nom %></td>
                                        <td><%= o.type %></td>
                                        <td><%= o.adresse_admini %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Script pour gérer l'affichage des sections en fonction du bouton cliqué -->
    <script>
        document.getElementById('btnUtilisateurs').addEventListener('click', function() {
            document.getElementById('utilisateursSection').classList.remove('d-none');
            document.getElementById('organisationsSection').classList.add('d-none');
        });

        document.getElementById('btnOrganisations').addEventListener('click', function() {
            document.getElementById('utilisateursSection').classList.add('d-none');
            document.getElementById('organisationsSection').classList.remove('d-none');
        });
    </script>
</body>
</html>
